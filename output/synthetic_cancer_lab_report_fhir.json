    {
      "fullUrl": "urn:uuid:f2775f40-1a3b-414b-9d76-4dc6be5c36d6",
      "resource": {
        "resourceType": "DiagnosticReport",
        "id": "f2775f40-1a3b-414b-9d76-4dc6be5c36d6",
        "text": {
          "status": "generated",
          "div": "<div xmlns=\"http://www.w3.org/1999/xhtml\"><h2>Multi-Cancer Early Detection Screening Report</h2><p><b>Conclusion:</b> A cancer signal was detected in this synthetic blood sample. This result indicates that cell-free DNA (cfDNA) methylation patterns associated with cancer were identified. Further clinical evaluation, such as imaging or other diagnostic tests, is required to confirm the presence of cancer and determine the location.</p></div>"
        },
        "identifier": [
