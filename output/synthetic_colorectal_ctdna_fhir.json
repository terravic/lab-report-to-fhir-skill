    {
      "fullUrl": "urn:uuid:3539eb8f-45dd-4c18-ab0a-c2db0b149137",
      "resource": {
        "resourceType": "DiagnosticReport",
        "id": "3539eb8f-45dd-4c18-ab0a-c2db0b149137",
        "text": {
          "status": "generated",
          "div": "<div xmlns=\"http://www.w3.org/1999/xhtml\"><h2>Liquid Biopsy Colorectal ctDNA Early Screening Report</h2><p><b>Conclusion:</b> Elevated circulating tumor DNA (ctDNA) markers detected in synthetic sample. Aberrant SEPT9 promoter hypermethylation and somatic mutations in KRAS and TP53 were identified in plasma cfDNA.</p></div>"
        },
        "identifier": [
